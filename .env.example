# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-strong-random-secret
CRON_SECRET=replace-with-a-strong-random-secret
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database / queue
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/openreply
REDIS_URL=redis://localhost:6379

# Email magic links (Gmail SMTP example; use a Google App Password, not your
# normal Gmail password. URL-encode special characters and remove spaces.)
# EMAIL_SERVER=smtps://you%40gmail.com:app-password@smtp.gmail.com:465
EMAIL_FROM=you@gmail.com
ALLOWED_EMAILS=you@gmail.com

# Optional alternative: Resend
# RESEND_API_KEY=re_...

# ALLOWED_EMAILS restricts sign-in to your address (comma-separated and
# case-insensitive). EMAIL_SERVER takes over from Resend when configured.

# Meta / Instagram
META_GRAPH_API_VERSION=v25.0
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
FACEBOOK_APP_SECRET=your-facebook-app-secret
WEBHOOK_VERIFY_TOKEN=replace-with-a-webhook-verify-token
